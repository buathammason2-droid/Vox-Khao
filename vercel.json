{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "functions": {"api/index.js": {"maxDuration": 120,"includeFiles":"dist/server/index.js"}},
  "rewrites": [{"source":"/api/:path*","destination":"/api"}]
}
